NODE_ENV=production
PORT=3000
LOG_LEVEL=warn

AUTH_ENCODING_KEY=secret
AUTH_ENCODING_ALGORITHM=algorithm

SENSORS_CLEAR_ON_START=true
SENSORS_CALC_PERIOD=2.5

ESP_HTTP_TIMEOUT=6000
ASICS_HTTP_TIMEOUT=500

ESP_ENDPOINT=http://esp8266.local
ESP_WS_ENDPOINT=ws://esp8266.local:81

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=postgres
